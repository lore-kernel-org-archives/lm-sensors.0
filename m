+		data->reg.cpu_vid =3D i2c_smbus_read_byte_data(client, ATXP1_CVID);
+		data->reg.gpio1 =3D i2c_smbus_read_byte_data(client, ATXP1_GPIO1);
+		data->reg.gpio2 =3D i2c_smbus_read_byte_data(client, ATXP1_GPIO2);
