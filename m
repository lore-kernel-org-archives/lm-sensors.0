+int lm85_read_value(struct i2c_client *client, u8 reg)
+{
+	int res;
+
+	/* What size location is it? */
+	switch( reg ) {
+	case LM85_REG_FAN(0) :  /* Read WORD data */
+	case LM85_REG_FAN(1) :
+	case LM85_REG_FAN(2) :
+	case LM85_REG_FAN(3) :
+	case LM85_REG_FAN_MIN(0) :
+	case LM85_REG_FAN_MIN(1) :
+	case LM85_REG_FAN_MIN(2) :
+	case LM85_REG_FAN_MIN(3) :
+	case LM85_REG_ALARM1 :	/* Read both bytes at once */
+		res =3D i2c_smbus_read_byte_data(client, reg) & 0xff ;
+		res |=3D i2c_smbus_read_byte_data(client, reg+1) << 8 ;
+		break ;
+	case ADT7463_REG_TMIN_CTL1 :  /* Read WORD MSB, LSB */
+		res =3D i2c_smbus_read_byte_data(client, reg) << 8 ;
+		res |=3D i2c_smbus_read_byte_data(client, reg+1) & 0xff ;
+		break ;
+	default:	/* Read BYTE data */
+		res =3D i2c_smbus_read_byte_data(client, reg);
+		break ;
+	}
+
+	return res ;
+}
+
+int lm85_write_value(struct i2c_client *client, u8 reg, int value)
+{
+	int res ;
+
+	switch( reg ) {
+	case LM85_REG_FAN(0) :  /* Write WORD data */
+	case LM85_REG_FAN(1) :
+	case LM85_REG_FAN(2) :
+	case LM85_REG_FAN(3) :
+	case LM85_REG_FAN_MIN(0) :
+	case LM85_REG_FAN_MIN(1) :
+	case LM85_REG_FAN_MIN(2) :
+	case LM85_REG_FAN_MIN(3) :
+	/* NOTE: ALARM is read only, so not included here */
+		res =3D i2c_smbus_write_byte_data(client, reg, value & 0xff) ;
+		res |=3D i2c_smbus_write_byte_data(client, reg+1, (value>>8) & 0xff) ;
+		break ;
+	case ADT7463_REG_TMIN_CTL1 :  /* Write WORD MSB, LSB */
+		res =3D i2c_smbus_write_byte_data(client, reg, (value>>8) & 0xff);
+		res |=3D i2c_smbus_write_byte_data(client, reg+1, value & 0xff) ;
+		break ;
+	default:	/* Write BYTE data */
+		res =3D i2c_smbus_write_byte_data(client, reg, value);
+		break ;
+	}
+
+	return res ;
+}
+
+void lm85_init_client(struct i2c_client *client)
+{
+	int value;
+	struct lm85_data *data =3D i2c_get_clientdata(client);
+
+	dev_dbg(&client->dev, "Initializing device\n");
+
+	/* Warn if part was not "READY" */
+	value =3D lm85_read_value(client, LM85_REG_CONFIG);
+	dev_dbg(&client->dev, "LM85_REG_CONFIG is: 0x%02x\n", value);
+	if( value & 0x02 ) {
+		dev_err(&client->dev, "Client (%d,0x%02x) config is locked.\n",
+			    i2c_adapter_id(client->adapter), client->addr );
+	};
+	if( ! (value & 0x04) ) {
+		dev_err(&client->dev, "Client (%d,0x%02x) is not ready.\n",
+			    i2c_adapter_id(client->adapter), client->addr );
+	};
+	if( value & 0x10
+	    && ( data->type =3D adm1027
+		|| data->type =3D adt7463 ) ) {
+		dev_err(&client->dev, "Client (%d,0x%02x) VxI mode is set.  "
+			"Please report this to the lm85 maintainer.\n",
+			    i2c_adapter_id(client->adapter), client->addr );
+	};
+
+	/* WE INTENTIONALLY make no changes to the limits,
+	 *   offsets, pwms, fans and zones.  If they were
+	 *   configured, we don't want to mess with them.
+	 *   If they weren't, the default is 100% PWM, no
+	 *   control and will suffice until 'sensors -s'
+	 *   can be run by the user.
+	 */
+
+	/* Start monitoring */
+	value =3D lm85_read_value(client, LM85_REG_CONFIG);
+	/* Try to clear LOCK, Set START, save everything else */
+	value =3D (value & ~ 0x02) | 0x01 ;
+	dev_dbg(&client->dev, "Setting CONFIG to: 0x%02x\n", value);
+	lm85_write_value(client, LM85_REG_CONFIG, value);
+}
+
+static struct lm85_data *lm85_update_device(struct device *dev)
+{
+	struct i2c_client *client =3D to_i2c_client(dev);
+	struct lm85_data *data =3D i2c_get_clientdata(client);
+	int i;
+
+	down(&data->update_lock);
+
+	if ( !data->valid ||
+	     time_after(jiffies, data->last_reading + LM85_DATA_INTERVAL) ) {
+		/* Things that change quickly */
+		dev_dbg(&client->dev, "Reading sensor values\n");
+	=09
+		/* Have to read extended bits first to "freeze" the
+		 * more significant bits that are read later.
+		 */
+		if ( (data->type =3D adm1027) || (data->type =3D adt7463) ) {
+			int ext1 =3D lm85_read_value(client,
+						   ADM1027_REG_EXTEND_ADC1);
+			int ext2 =3D  lm85_read_value(client,
+						    ADM1027_REG_EXTEND_ADC2);
+			int val =3D (ext1 << 8) + ext2;
+
+			for(i =3D 0; i <=3D 4; i++)
+				data->in_ext[i] =3D (val>>(i * 2))&0x03;
+
+			for(i =3D 0; i <=3D 2; i++)
+				data->temp_ext[i] =3D (val>>((i + 5) * 2))&0x03;
+		}
+
+		/* adc_scale is 2^(number of LSBs). There are 4 extra bits in
+		   the emc6d102 and 2 in the adt7463 and adm1027. In all
+		   other chips ext is always 0 and the value of scale is
+		   irrelevant. So it is left in 4*/
+		data->adc_scale =3D (data->type =3D emc6d102 ) ? 16 : 4;
+
+		for (i =3D 0; i <=3D 4; ++i) {
+			data->in[i] +			    lm85_read_value(client, LM85_REG_IN(i));
+		}
+
+		for (i =3D 0; i <=3D 3; ++i) {
+			data->fan[i] +			    lm85_read_value(client, LM85_REG_FAN(i));
+		}
+
+		for (i =3D 0; i <=3D 2; ++i) {
+			data->temp[i] +			    lm85_read_value(client, LM85_REG_TEMP(i));
+		}
+
+		for (i =3D 0; i <=3D 2; ++i) {
+			data->pwm[i] +			    lm85_read_value(client, LM85_REG_PWM(i));
+		}
+
+		data->alarms =3D lm85_read_value(client, LM85_REG_ALARM1);
+
+		if ( data->type =3D adt7463 ) {
+			if( data->therm_total < ULONG_MAX - 256 ) {
+			    data->therm_total ++				lm85_read_value(client, ADT7463_REG_THERM );
+			}
+		} else if ( data->type =3D emc6d100 ) {
+			/* Three more voltage sensors */
+			for (i =3D 5; i <=3D 7; ++i) {
+				data->in[i] +					lm85_read_value(client, EMC6D100_REG_IN(i));
+			}
+			/* More alarm bits */
+			data->alarms |+				lm85_read_value(client, EMC6D100_REG_ALARM3) << 16;
+		} else if (data->type =3D emc6d102 ) {
+			/* Have to read LSB bits after the MSB ones because
+			   the reading of the MSB bits has frozen the
+			   LSBs (backward from the ADM1027).
+			 */
+			int ext1 =3D lm85_read_value(client,
+						   EMC6D102_REG_EXTEND_ADC1);
+			int ext2 =3D lm85_read_value(client,
+						   EMC6D102_REG_EXTEND_ADC2);
+			int ext3 =3D lm85_read_value(client,
+						   EMC6D102_REG_EXTEND_ADC3);
+			int ext4 =3D lm85_read_value(client,
+						   EMC6D102_REG_EXTEND_ADC4);
+			data->in_ext[0] =3D ext3 & 0x0f;
+			data->in_ext[1] =3D ext4 & 0x0f;
+			data->in_ext[2] =3D (ext4 >> 4) & 0x0f;
+			data->in_ext[3] =3D (ext3 >> 4) & 0x0f;
+			data->in_ext[4] =3D (ext2 >> 4) & 0x0f;
+
+			data->temp_ext[0] =3D ext1 & 0x0f;
+			data->temp_ext[1] =3D ext2 & 0x0f;
+			data->temp_ext[2] =3D (ext1 >> 4) & 0x0f;
+		}
+
+		data->last_reading =3D jiffies ;
+	};  /* last_reading */
+
+	if ( !data->valid ||
+	     time_after(jiffies, data->last_config + LM85_CONFIG_INTERVAL) ) {
+		/* Things that don't change often */
+		dev_dbg(&client->dev, "Reading config values\n");
+
+		for (i =3D 0; i <=3D 4; ++i) {
+			data->in_min[i] +			    lm85_read_value(client, LM85_REG_IN_MIN(i));
+			data->in_max[i] +			    lm85_read_value(client, LM85_REG_IN_MAX(i));
+		}
+
+		if ( data->type =3D emc6d100 ) {
+			for (i =3D 5; i <=3D 7; ++i) {
+				data->in_min[i] +					lm85_read_value(client, EMC6D100_REG_IN_MIN(i));
+				data->in_max[i] +					lm85_read_value(client, EMC6D100_REG_IN_MAX(i));
+			}
+		}
+
+		for (i =3D 0; i <=3D 3; ++i) {
+			data->fan_min[i] +			    lm85_read_value(client, LM85_REG_FAN_MIN(i));
+		}
+
+		for (i =3D 0; i <=3D 2; ++i) {
+			data->temp_min[i] +			    lm85_read_value(client, LM85_REG_TEMP_MIN(i));
+			data->temp_max[i] +			    lm85_read_value(client, LM85_REG_TEMP_MAX(i));
+		}
+
+		data->vid =3D lm85_read_value(client, LM85_REG_VID);
+
+		for (i =3D 0; i <=3D 2; ++i) {
+			int val ;
+			data->autofan[i].config +			    lm85_read_value(client, LM85_REG_AFAN_C=
ONFIG(i));
+			val =3D lm85_read_value(client, LM85_REG_AFAN_RANGE(i));
+			data->autofan[i].freq =3D val & 0x07 ;
+			data->zone[i].range =3D (val >> 4) & 0x0f ;
+			data->autofan[i].min_pwm +			    lm85_read_value(client, LM85_REG_AFAN_=
MINPWM(i));
+			data->zone[i].limit +			    lm85_read_value(client, LM85_REG_AFAN_LIMIT=
(i));
+			data->zone[i].critical +			    lm85_read_value(client, LM85_REG_AFAN_CR=
ITICAL(i));
+		}
+
+		i =3D lm85_read_value(client, LM85_REG_AFAN_SPIKE1);
+		data->smooth[0] =3D i & 0x0f ;
+		data->syncpwm3 =3D i & 0x10 ;  /* Save PWM3 config */
+		data->autofan[0].min_off =3D (i & 0x20) !=3D 0 ;
+		data->autofan[1].min_off =3D (i & 0x40) !=3D 0 ;
+		data->autofan[2].min_off =3D (i & 0x80) !=3D 0 ;
+		i =3D lm85_read_value(client, LM85_REG_AFAN_SPIKE2);
+		data->smooth[1] =3D (i>>4) & 0x0f ;
+		data->smooth[2] =3D i & 0x0f ;
+
+		i =3D lm85_read_value(client, LM85_REG_AFAN_HYST1);
+		data->zone[0].hyst =3D (i>>4) & 0x0f ;
+		data->zone[1].hyst =3D i & 0x0f ;
+
+		i =3D lm85_read_value(client, LM85_REG_AFAN_HYST2);
+		data->zone[2].hyst =3D (i>>4) & 0x0f ;
+
+		if ( (data->type =3D lm85b) || (data->type =3D lm85c) ) {
+			data->tach_mode =3D lm85_read_value(client,
+				LM85_REG_TACH_MODE );
+			data->spinup_ctl =3D lm85_read_value(client,
+				LM85_REG_SPINUP_CTL );
+		} else if ( (data->type =3D adt7463) || (data->type =3D adm1027) ) {
+			if ( data->type =3D adt7463 ) {
+				for (i =3D 0; i <=3D 2; ++i) {
+				    data->oppoint[i] =3D lm85_read_value(client,
+					ADT7463_REG_OPPOINT(i) );
+				}
+				data->tmin_ctl =3D lm85_read_value(client,
+					ADT7463_REG_TMIN_CTL1 );
+				data->therm_limit =3D lm85_read_value(client,
+					ADT7463_REG_THERM_LIMIT );
+			}
+			for (i =3D 0; i <=3D 2; ++i) {
+			    data->temp_offset[i] =3D lm85_read_value(client,
+				ADM1027_REG_TEMP_OFFSET(i) );
+			}
+			data->tach_mode =3D lm85_read_value(client,
+				ADM1027_REG_CONFIG3 );
+			data->fan_ppr =3D lm85_read_value(client,
+				ADM1027_REG_FAN_PPR );
+		}
+=09
+		data->last_config =3D jiffies;
+	};  /* last_config */
+
+	data->valid =3D 1;
+
+	up(&data->update_lock);
+
+	return data;
+}
+
+
