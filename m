ttribute *attr, char *buf) \
+{ \
+	struct adm1025_data *data =3D adm1025_update_device(dev); \
+	return sprintf(buf, "%d\n", TEMP_FROM_REG(data->temp_min[offset-1])); \
+} \
+static ssize_t show_temp##offset##_max(struct device *dev, struct device_a=
ttribute *attr, char *buf) \
+{ \
+	struct adm1025_data *data =3D adm1025_update_device(dev); \
+	return sprintf(buf, "%d\n", TEMP_FROM_REG(data->temp_max[offset-1])); \
+}\
+static DEVICE_ATTR(temp##offset##_input, S_IRUGO, show_temp##offset, NULL);
+show_temp(1);
+show_temp(2);
+
+#define set_in(offset) \
+static ssize_t set_in##offset##_min(struct device *dev, struct device_attr=
ibute *attr, const char *buf, \
+	size_t count) \
+{ \
+	struct i2c_client *client =3D to_i2c_client(dev); \
+	struct adm1025_data *data =3D i2c_get_clientdata(client); \
