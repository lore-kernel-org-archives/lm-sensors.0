-			data->in_min[i] =3D i2c_smbus_read_byte_data(client,
-					  ADM1025_REG_IN_MIN(i));
-			data->in_max[i] =3D i2c_smbus_read_byte_data(client,
-					  ADM1025_REG_IN_MAX(i));
-		}
-		for (i=3D0; i<2; i++) {
-			data->temp[i] =3D i2c_smbus_read_byte_data(client,
-					ADM1025_REG_TEMP(i));
