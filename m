+	data->zone[nr].off_desired =3D TEMP_TO_REG(val);
+	data->zone[nr].hyst =3D HYST_TO_REG(min - val);
+	if ( nr =3D 0 || nr =3D 1 ) {
+		lm85_write_value(client, LM85_REG_AFAN_HYST1,
+			(data->zone[0].hyst << 4)
+			| data->zone[1].hyst
