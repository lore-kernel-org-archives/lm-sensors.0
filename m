+static struct adm9240_data *adm9240_update_device(struct device *dev)
+{
+	struct i2c_client *client =3D to_i2c_client(dev);
+	struct adm9240_data *data =3D i2c_get_clientdata(client);
+	int i;
+
+	down(&data->update_lock);
+
+	/* minimum measurement cycle: 1.75 seconds */
+	if (time_after(jiffies, data->last_updated_measure + (HZ * 7 / 4))
+			|| !data->valid) {
+
+		for (i =3D 0; i < 6; i++) /* read voltages */
+		{
+			data->in[i] =3D adm9240_read_value(client,
+					ADM9240_REG_IN(i));
+		}
+		data->alarms =3D adm9240_read_value(client,
+					ADM9240_REG_INT(0)) |
+					adm9240_read_value(client,
+					ADM9240_REG_INT(1)) << 8;
+
+		/* read temperature: assume temperature changes less than
+		 * 0.5'C per two measurement cycles thus ignore possible
+		 * but unlikely aliasing error on lsb reading. --Grant */
+		data->temp =3D ((adm9240_read_value(client,
+					ADM9240_REG_TEMP) << 8) |
+					adm9240_read_value(client,
+					ADM9240_REG_TEMP_CONF)) / 128;
+
+		for (i =3D 0; i < 2; i++) /* read fans */
+		{
+			data->fan[i] =3D adm9240_read_value(client,
+					ADM9240_REG_FAN(i));
+
+			/* adjust fan clock divider on overflow */
+			if (data->valid && data->fan[i] =3D 255 &&
+					data->fan_div[i] < 3) {
+
+				adm9240_write_fan_div(client, i,
+						++data->fan_div[i]);
+
+				/* adjust fan_min if active, but not to 0 */
+				if (data->fan_min[i] < 255 &&
+						data->fan_min[i] >=3D 2)
+					data->fan_min[i] /=3D 2;
+			}
+		}
+		data->last_updated_measure =3D jiffies;
+	}
+
+	/* minimum config reading cycle: 300 seconds */
+	if (time_after(jiffies, data->last_updated_config + (HZ * 300))
+			|| !data->valid) {
+
+		for (i =3D 0; i < 6; i++)
+		{
+			data->in_min[i] =3D adm9240_read_value(client,
+					ADM9240_REG_IN_MIN(i));
+			data->in_max[i] =3D adm9240_read_value(client,
+					ADM9240_REG_IN_MAX(i));
+		}
+		for (i =3D 0; i < 2; i++)
+		{
+			data->fan_min[i] =3D adm9240_read_value(client,
+					ADM9240_REG_FAN_MIN(i));
+		}
+		data->temp_high =3D adm9240_read_value(client,
+				ADM9240_REG_TEMP_HIGH);
+		data->temp_hyst =3D adm9240_read_value(client,
+				ADM9240_REG_TEMP_HYST);
+
+		/* read fan divs and 5-bit VID */
+		i =3D adm9240_read_value(client, ADM9240_REG_VID_FAN_DIV);
+		data->fan_div[0] =3D (i >> 4) & 3;
+		data->fan_div[1] =3D (i >> 6) & 3;
+		data->vid =3D i & 0x0f;
+		data->vid |=3D (adm9240_read_value(client,
+					ADM9240_REG_VID4) & 1) << 4;
+		/* read analog out */
+		data->aout =3D adm9240_read_value(client,
+				ADM9240_REG_ANALOG_OUT);
+
+		data->last_updated_config =3D jiffies;
+		data->valid =3D 1;
+	}
+	up(&data->update_lock);
+	return data;
+}
+
+static int __init sensors_adm9240_init(void)
+{
+	return i2c_add_driver(&adm9240_driver);
+}
+
+static void __exit sensors_adm9240_exit(void)
+{
+	i2c_del_driver(&adm9240_driver);
+}
