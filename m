+			if (i2c_smbus_read_byte_data(new_client, i + 1) !=3D conf
+			 || i2c_smbus_read_word_data(new_client, i + 2) !=3D hyst
+			 || i2c_smbus_read_word_data(new_client, i + 3) !=3D os)
+				goto exit_free;
+	}
