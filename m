+
+static struct i2c_driver adm1025_driver =3D {
+	.owner		=3D THIS_MODULE,
+	.name		=3D "adm1025",
+	.id		=3D I2C_DRIVERID_ADM1025,
+	.flags		=3D I2C_DF_NOTIFY,
+	.attach_adapter	=3D adm1025_attach_adapter,
+	.detach_client	=3D adm1025_detach_client,
+};
+
+/*
+ * Client data (each client gets its own)
