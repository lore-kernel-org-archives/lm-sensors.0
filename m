+
+static ssize_t atxp1_storevcore(struct device *dev, struct device_attribut=
e *attr, const char *buf, size_t count)
+{
+	struct atxp1_data *data;
+	struct i2c_client *client;
+	char vid;
+	char cvid;
+	unsigned int vcore;
+
+	client =3D to_i2c_client(dev);
+	data =3D atxp1_update_device(dev);
