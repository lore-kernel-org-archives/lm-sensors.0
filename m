+	int first_match =3D -1, exact_match =3D -1;
+	u8 other_reg_val +	    (*data->chan_select_table)[FAN_CHAN_FROM_REG(reg)]=
[chan ? 0 : 1];
+
+	if (val =3D 0) {
+		*new_reg =3D 0;
+		return 0;
+	}
+
+	for (i =3D 0; i < 8; i++) {
+		if ((val =3D (*data->chan_select_table)[i][chan]) &&
+		    ((*data->chan_select_table)[i][chan ? 0 : 1] =3D
+		     other_reg_val)) {
+			/* We found an exact match */
+			exact_match =3D i;
+			break;
+		} else if (val =3D (*data->chan_select_table)[i][chan] &&
+			   first_match =3D -1) {
+			/* Save the first match in case of an exact match has not been
+			 * found=20
+			 */
+			first_match =3D i;
+		}
+	}
