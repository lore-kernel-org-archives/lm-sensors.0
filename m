+/* This function is called when:
+     * w83627hf_driver is inserted (when this module is loaded), for each
+       available adapter
+     * when a new adapter is inserted (and w83627hf_driver is still presen=
t) */
+static int w83627hf_attach_adapter(struct i2c_adapter *adapter)
+{
+	return i2c_detect(adapter, &addr_data, w83627hf_detect);
+}
+
+static int w83627hf_find(int sioaddr, int *address)
+{
+	u16 val;
+
+	REG =3D sioaddr;
+	VAL =3D sioaddr + 1;
+
+	superio_enter();
+	val=3D superio_inb(DEVID);
+	if(val !=3D W627_DEVID &&
+	   val !=3D W627THF_DEVID &&
+	   val !=3D W697_DEVID &&
+	   val !=3D W637_DEVID) {
+		superio_exit();
+		return -ENODEV;
+	}
+
+	superio_select(W83627HF_LD_HWM);
+	val =3D (superio_inb(WINB_BASE_REG) << 8) |
+	       superio_inb(WINB_BASE_REG + 1);
+	*address =3D val & ~(WINB_EXTENT - 1);
+	if (*address =3D 0 && force_addr =3D 0) {
+		superio_exit();
+		return -ENODEV;
+	}
+	if (force_addr)
+		*address =3D force_addr;	/* so detect will get called */
+
+	superio_exit();
+	return 0;
+}
+
+int w83627hf_detect(struct i2c_adapter *adapter, int address,
+		   int kind)
+{
+	int val;
+	struct i2c_client *new_client;
+	struct w83627hf_data *data;
+	int err =3D 0;
+	const char *client_name =3D "";
+
+	if (!i2c_is_isa_adapter(adapter)) {
+		err =3D -ENODEV;
+		goto ERROR0;
+	}
+
+	if(force_addr)
+		address =3D force_addr & ~(WINB_EXTENT - 1);
+
+	if (!request_region(address, WINB_EXTENT, w83627hf_driver.name)) {
+		err =3D -EBUSY;
+		goto ERROR0;
+	}
+
+	if(force_addr) {
+		printk("w83627hf.o: forcing ISA address 0x%04X\n", address);
+		superio_enter();
+		superio_select(W83627HF_LD_HWM);
+		superio_outb(WINB_BASE_REG, address >> 8);
+		superio_outb(WINB_BASE_REG+1, address & 0xff);
+		superio_exit();
+	}
+
+	superio_enter();
+	val=3D superio_inb(DEVID);
+	if(val =3D W627_DEVID)
+		kind =3D w83627hf;
+	else if(val =3D W697_DEVID)
+		kind =3D w83697hf;
+	else if(val =3D W627THF_DEVID)
+		kind =3D w83627thf;
+	else if(val =3D W637_DEVID)
+		kind =3D w83637hf;
+	else {
+		dev_info(&adapter->dev,
+			 "Unsupported chip (dev_id=3D0x%02X).\n", val);
+		goto ERROR1;
+	}
+
+	superio_select(W83627HF_LD_HWM);
+	if((val =3D 0x01 & superio_inb(WINB_ACT_REG)) =3D 0)
+		superio_outb(WINB_ACT_REG, 1);
+	superio_exit();
+
+	/* OK. For now, we presume we have a valid client. We now create the
+	   client structure, even though we cannot fill it completely yet.
+	   But it allows us to access w83627hf_{read,write}_value. */
+
+	if (!(data =3D kmalloc(sizeof(struct w83627hf_data), GFP_KERNEL))) {
+		err =3D -ENOMEM;
+		goto ERROR1;
+	}
+	memset(data, 0, sizeof(struct w83627hf_data));
+
+	new_client =3D &data->client;
+	i2c_set_clientdata(new_client, data);
+	new_client->addr =3D address;
+	init_MUTEX(&data->lock);
+	new_client->adapter =3D adapter;
+	new_client->driver =3D &w83627hf_driver;
+	new_client->flags =3D 0;
+
+
+	if (kind =3D w83627hf) {
+		client_name =3D "w83627hf";
+	} else if (kind =3D w83627thf) {
+		client_name =3D "w83627thf";
+	} else if (kind =3D w83697hf) {
+		client_name =3D "w83697hf";
+	} else if (kind =3D w83637hf) {
+		client_name =3D "w83637hf";
+	}
+
+	/* Fill in the remaining client fields and put into the global list */
+	strlcpy(new_client->name, client_name, I2C_NAME_SIZE);
+	data->type =3D kind;
+	data->valid =3D 0;
+	init_MUTEX(&data->update_lock);
+
+	/* Tell the I2C layer a new client has arrived */
+	if ((err =3D i2c_attach_client(new_client)))
+		goto ERROR2;
+
+	data->lm75 =3D NULL;
+
+	/* Initialize the chip */
+	w83627hf_init_client(new_client);
+
+	/* A few vars need to be filled upon startup */
+	data->fan_min[0] =3D w83627hf_read_value(new_client, W83781D_REG_FAN_MIN(=
1));
+	data->fan_min[1] =3D w83627hf_read_value(new_client, W83781D_REG_FAN_MIN(=
2));
+	data->fan_min[2] =3D w83627hf_read_value(new_client, W83781D_REG_FAN_MIN(=
3));
+
+	/* Register sysfs hooks */
+	device_create_file_in(new_client, 0);
+	if (kind !=3D w83697hf)
+		device_create_file_in(new_client, 1);
+	device_create_file_in(new_client, 2);
+	device_create_file_in(new_client, 3);
+	device_create_file_in(new_client, 4);
+	if (kind !=3D w83627thf && kind !=3D w83637hf) {
+		device_create_file_in(new_client, 5);
+		device_create_file_in(new_client, 6);
+	}
+	device_create_file_in(new_client, 7);
+	device_create_file_in(new_client, 8);
+
+	device_create_file_fan(new_client, 1);
+	device_create_file_fan(new_client, 2);
+	if (kind !=3D w83697hf)
+		device_create_file_fan(new_client, 3);
+
+	device_create_file_temp(new_client, 1);
+	device_create_file_temp(new_client, 2);
+	if (kind !=3D w83697hf)
+		device_create_file_temp(new_client, 3);
+
+	if (kind !=3D w83697hf)
+		device_create_file_vid(new_client);
+
+	if (kind !=3D w83697hf)
+		device_create_file_vrm(new_client);
+
+	device_create_file_fan_div(new_client, 1);
+	device_create_file_fan_div(new_client, 2);
+	if (kind !=3D w83697hf)
+		device_create_file_fan_div(new_client, 3);
+
+	device_create_file_alarms(new_client);
+
+	device_create_file_beep(new_client);
+
+	device_create_file_pwm(new_client, 1);
+	device_create_file_pwm(new_client, 2);
+	if (kind =3D w83627thf || kind =3D w83637hf)
+		device_create_file_pwm(new_client, 3);
+
+	device_create_file_sensor(new_client, 1);
+	device_create_file_sensor(new_client, 2);
+	if (kind !=3D w83697hf)
+		device_create_file_sensor(new_client, 3);
+
+	return 0;
+
+      ERROR2:
+	kfree(data);
+      ERROR1:
