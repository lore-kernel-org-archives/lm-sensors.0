-	down(&data->update_lock);
-
-	if (time_after(jiffies, data->last_updated + HZ * 2) || !data->valid) {
-		int i;
-
-		dev_dbg(&client->dev, "Updating data.\n");
-		for (i=3D0; i<6; i++) {
-			data->in[i] =3D i2c_smbus_read_byte_data(client,
