+/* Registers 0x07 to 0x0c are word-sized, others are byte-sized=20
+   GL520 uses a high-byte first convention */
+static int gl520_read_value(struct i2c_client *client, u8 reg)
+{
+	if ((reg >=3D 0x07) && (reg <=3D 0x0c))
+		return swab16(i2c_smbus_read_word_data(client, reg));
+	else
+		return i2c_smbus_read_byte_data(client, reg);
+}
+
+static int gl520_write_value(struct i2c_client *client, u8 reg, u16 value)
+{
+	if ((reg >=3D 0x07) && (reg <=3D 0x0c))
+		return i2c_smbus_write_word_data(client, reg, swab16(value));
+	else
+		return i2c_smbus_write_byte_data(client, reg, value);
+}
+
+
+static struct gl520_data *gl520_update_device(struct device *dev)
+{
+	struct i2c_client *client =3D to_i2c_client(dev);
+	struct gl520_data *data =3D i2c_get_clientdata(client);
+	int val;
+
+	down(&data->update_lock);
+
+	if ((jiffies - data->last_updated > 2 * HZ) ||
+	    (jiffies < data->last_updated) || !data->valid) {
+
+		dev_dbg(&client->dev, "Starting gl520sm update\n");
+
+		data->alarms =3D gl520_read_value(client, GL520_REG_ALARMS);
+		data->beep_mask =3D gl520_read_value(client, GL520_REG_BEEP_MASK);
+		data->vid =3D gl520_read_value(client, GL520_REG_VID_INPUT) & 0x1f;
+
+		val =3D gl520_read_value(client, GL520_REG_IN0_LIMIT);
+		data->in_min[0] =3D val & 0xff;
+		data->in_max[0] =3D (val >> 8) & 0xff;
+		val =3D gl520_read_value(client, GL520_REG_IN1_LIMIT);
+		data->in_min[1] =3D val & 0xff;
+		data->in_max[1] =3D (val >> 8) & 0xff;
+		val =3D gl520_read_value(client, GL520_REG_IN2_LIMIT);
+		data->in_min[2] =3D val & 0xff;
+		data->in_max[2] =3D (val >> 8) & 0xff;
+		val =3D gl520_read_value(client, GL520_REG_IN3_LIMIT);
+		data->in_min[3] =3D val & 0xff;
+		data->in_max[3] =3D (val >> 8) & 0xff;
+
+		val =3D gl520_read_value(client, GL520_REG_FAN_INPUT);
+		data->fan_input[0] =3D (val >> 8) & 0xff;
+		data->fan_input[1] =3D val & 0xff;
+
+		val =3D gl520_read_value(client, GL520_REG_FAN_MIN);
+		data->fan_min[0] =3D (val >> 8) & 0xff;
+		data->fan_min[1] =3D val & 0xff;
+
+		data->temp_input[0] =3D gl520_read_value(client, GL520_REG_TEMP1_INPUT);
+		data->temp_max[0] =3D gl520_read_value(client, GL520_REG_TEMP1_MAX);
+		data->temp_max_hyst[0] =3D gl520_read_value(client, GL520_REG_TEMP1_MAX_=
HYST);
+
+		val =3D gl520_read_value(client, GL520_REG_FAN_DIV);
+		data->fan_div[0] =3D (val >> 6) & 0x03;
+		data->fan_div[1] =3D (val >> 4) & 0x03;
+		data->fan_off =3D (val >> 2) & 0x01;
+
+		data->alarms &=3D data->alarm_mask;
+
+		val =3D gl520_read_value(client, GL520_REG_CONF);
+		data->beep_enable =3D !((val >> 2) & 1);
+
+		data->in_input[0] =3D gl520_read_value(client, GL520_REG_IN0_INPUT);
+		data->in_input[1] =3D gl520_read_value(client, GL520_REG_IN1_INPUT);
+		data->in_input[2] =3D gl520_read_value(client, GL520_REG_IN2_INPUT);
+		data->in_input[3] =3D gl520_read_value(client, GL520_REG_IN3_INPUT);
+
+		/* Temp1 and Vin4 are the same input */
+		if (data->two_temps) {
+			data->temp_input[1] =3D gl520_read_value(client, GL520_REG_TEMP2_INPUT);
+			data->temp_max[1] =3D gl520_read_value(client, GL520_REG_TEMP2_MAX);
+			data->temp_max_hyst[1] =3D gl520_read_value(client, GL520_REG_TEMP2_MAX=
_HYST);
+		} else {
+			data->in_input[4] =3D gl520_read_value(client, GL520_REG_IN4_INPUT);
+			data->in_min[4] =3D gl520_read_value(client, GL520_REG_IN4_MIN);
+			data->in_max[4] =3D gl520_read_value(client, GL520_REG_IN4_MAX);
+		}
+
+		data->last_updated =3D jiffies;
+		data->valid =3D 1;
+	}
+
+	up(&data->update_lock);
+
+	return data;
+}
+
+
+static int __init sensors_gl520sm_init(void)
+{
+	return i2c_add_driver(&gl520_driver);
+}
+
+static void __exit sensors_gl520sm_exit(void)
+{
+	i2c_del_driver(&gl520_driver);
+}
