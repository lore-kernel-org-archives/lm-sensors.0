+	new_min =3D data->fan_min[fan] * old_div / new_div;
+	new_min =3D SENSORS_LIMIT(new_min, 1, 254);
+	data->fan_min[fan] =3D new_min;
+	adm1026_write_value(client, ADM1026_REG_FAN_MIN(fan), new_min);
