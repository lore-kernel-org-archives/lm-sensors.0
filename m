tribute *attr, const char *buf, \
+	size_t count) \
+{ \
+	struct i2c_client *client =3D to_i2c_client(dev); \
+	struct adm1025_data *data =3D i2c_get_clientdata(client); \
+	long val =3D simple_strtol(buf, NULL, 10); \
+ \
