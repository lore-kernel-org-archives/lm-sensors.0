+static struct lm87_data *lm87_update_device(struct device *dev)
+{
+	struct i2c_client *client =3D to_i2c_client(dev);
+	struct lm87_data *data =3D i2c_get_clientdata(client);
+
+	down(&data->update_lock);
+
+	if (time_after(jiffies, data->last_updated + HZ) || !data->valid) {
+		int i, j;
+
+		dev_dbg(&client->dev, "Updating data.\n");
+
+		i =3D (data->channel & CHAN_TEMP3) ? 1 : 0;
+		j =3D (data->channel & CHAN_TEMP3) ? 5 : 6;
+		for (; i < j; i++) {
+			data->in[i] =3D lm87_read_value(client,
+				      LM87_REG_IN(i));
+			data->in_min[i] =3D lm87_read_value(client,
+					  LM87_REG_IN_MIN(i));
+			data->in_max[i] =3D lm87_read_value(client,
+					  LM87_REG_IN_MAX(i));
+		}
+
+		for (i =3D 0; i < 2; i++) {
+			if (data->channel & CHAN_NO_FAN(i)) {
+				data->in[6+i] =3D lm87_read_value(client,
+						LM87_REG_AIN(i));
+				data->in_max[6+i] =3D lm87_read_value(client,
+						    LM87_REG_AIN_MAX(i));
+				data->in_min[6+i] =3D lm87_read_value(client,
+						    LM87_REG_AIN_MIN(i));
+
+			} else {
+				data->fan[i] =3D lm87_read_value(client,
+					       LM87_REG_FAN(i));
+				data->fan_min[i] =3D lm87_read_value(client,
+						   LM87_REG_FAN_MIN(i));
+			}
+		}
+
+		j =3D (data->channel & CHAN_TEMP3) ? 3 : 2;
+		for (i =3D 0 ; i < j; i++) {
+			data->temp[i] =3D lm87_read_value(client,
+					LM87_REG_TEMP[i]);
+			data->temp_high[i] =3D lm87_read_value(client,
+					     LM87_REG_TEMP_HIGH[i]);
+			data->temp_low[i] =3D lm87_read_value(client,
+					    LM87_REG_TEMP_LOW[i]);
+		}
+
+		i =3D lm87_read_value(client, LM87_REG_TEMP_HW_INT_LOCK);
+		j =3D lm87_read_value(client, LM87_REG_TEMP_HW_INT);
+		data->temp_crit_int =3D min(i, j);
+
+		i =3D lm87_read_value(client, LM87_REG_TEMP_HW_EXT_LOCK);
+		j =3D lm87_read_value(client, LM87_REG_TEMP_HW_EXT);
+		data->temp_crit_ext =3D min(i, j);
+
+		i =3D lm87_read_value(client, LM87_REG_VID_FAN_DIV);
+		data->fan_div[0] =3D (i >> 4) & 0x03;
+		data->fan_div[1] =3D (i >> 6) & 0x03;
+		data->vid =3D (i & 0x0F)
+			  | (lm87_read_value(client, LM87_REG_VID4) & 0x01)
+			     << 4;
+
+		data->alarms =3D lm87_read_value(client, LM87_REG_ALARMS1)
+			     | (lm87_read_value(client, LM87_REG_ALARMS2)
+				<< 8);
+		data->aout =3D lm87_read_value(client, LM87_REG_AOUT);
+
+		data->last_updated =3D jiffies;
+		data->valid =3D 1;
+	}
+
+	up(&data->update_lock);
+
+	return data;
+}
+
+static int __init sensors_lm87_init(void)
+{
+	return i2c_add_driver(&lm87_driver);
+}
+
+static void __exit sensors_lm87_exit(void)
+{
+	i2c_del_driver(&lm87_driver);
+}
+
+MODULE_AUTHOR("Jean Delvare <khali@linux-fr.org> and others");
+MODULE_DESCRIPTION("LM87 driver");
+MODULE_LICENSE("GPL");
+
+module_init(sensors_lm87_init);
+module_exit(sensors_lm87_exit);
