+static struct adm1026_data *adm1026_update_device(struct device *dev)
+{
+	struct i2c_client *client =3D to_i2c_client(dev);
+	struct adm1026_data *data =3D i2c_get_clientdata(client);
+	int i;
+	long value, alarms, gpio;
+
+	down(&data->update_lock);
+	if (!data->valid
+	    || time_after(jiffies, data->last_reading + ADM1026_DATA_INTERVAL)) {
+		/* Things that change quickly */
+		dev_dbg(&client->dev,"Reading sensor values\n");
+		for (i =3D 0;i <=3D 16;++i) {
+			data->in[i] +			    adm1026_read_value(client, ADM1026_REG_IN[i]);
+		}
+
+		for (i =3D 0;i <=3D 7;++i) {
+			data->fan[i] +			    adm1026_read_value(client, ADM1026_REG_FAN(i));
+		}
+
+		for (i =3D 0;i <=3D 2;++i) {
+			/* NOTE: temp[] is s8 and we assume 2's complement
+			 *   "conversion" in the assignment   */
+			data->temp[i] +			    adm1026_read_value(client, ADM1026_REG_TEMP[i]);
+		}
+
+		data->pwm1.pwm =3D adm1026_read_value(client,=20
+			ADM1026_REG_PWM);
+		data->analog_out =3D adm1026_read_value(client,=20
+			ADM1026_REG_DAC);
+		/* GPIO16 is MSbit of alarms, move it to gpio */
+		alarms =3D adm1026_read_value(client, ADM1026_REG_STATUS4);
+		gpio =3D alarms & 0x80 ? 0x0100 : 0;  /* GPIO16 */
+		alarms &=3D 0x7f;
+		alarms <<=3D 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_STATUS3);
+		alarms <<=3D 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_STATUS2);
+		alarms <<=3D 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_STATUS1);
+		data->alarms =3D alarms;
+
+		/* Read the GPIO values */
+		gpio |=3D adm1026_read_value(client,=20
+			ADM1026_REG_GPIO_STATUS_8_15);
+		gpio <<=3D 8;
+		gpio |=3D adm1026_read_value(client,=20
+			ADM1026_REG_GPIO_STATUS_0_7);
+		data->gpio =3D gpio;
+
+		data->last_reading =3D jiffies;
+	};  /* last_reading */
+
+	if (!data->valid ||
+	    time_after(jiffies, data->last_config + ADM1026_CONFIG_INTERVAL)) {
+		/* Things that don't change often */
+		dev_dbg(&client->dev, "Reading config values\n");
+		for (i =3D 0;i <=3D 16;++i) {
+			data->in_min[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_IN_MIN[i]);
+			data->in_max[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_IN_MAX[i]);
+		}
+
+		value =3D adm1026_read_value(client, ADM1026_REG_FAN_DIV_0_3)
+			| (adm1026_read_value(client, ADM1026_REG_FAN_DIV_4_7)
+			<< 8);
+		for (i =3D 0;i <=3D 7;++i) {
+			data->fan_min[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_FAN_MIN(i));
+			data->fan_div[i] =3D DIV_FROM_REG(value & 0x03);
+			value >>=3D 2;
+		}
+
+		for (i =3D 0; i <=3D 2; ++i) {
+			/* NOTE: temp_xxx[] are s8 and we assume 2's=20
+			 *    complement "conversion" in the assignment
+			 */
+			data->temp_min[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_TEMP_MIN[i]);
+			data->temp_max[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_TEMP_MAX[i]);
+			data->temp_tmin[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_TEMP_TMIN[i]);
+			data->temp_crit[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_TEMP_THERM[i]);
+			data->temp_offset[i] =3D adm1026_read_value(client,=20
+				ADM1026_REG_TEMP_OFFSET[i]);
+		}
+
+		/* Read the STATUS/alarm masks */
+		alarms  =3D adm1026_read_value(client, ADM1026_REG_MASK4);
+		gpio    =3D alarms & 0x80 ? 0x0100 : 0;  /* GPIO16 */
+		alarms  =3D (alarms & 0x7f) << 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_MASK3);
+		alarms <<=3D 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_MASK2);
+		alarms <<=3D 8;
+		alarms |=3D adm1026_read_value(client, ADM1026_REG_MASK1);
+		data->alarm_mask =3D alarms;
+
+		/* Read the GPIO values */
+		gpio |=3D adm1026_read_value(client,=20
+			ADM1026_REG_GPIO_MASK_8_15);
+		gpio <<=3D 8;
+		gpio |=3D adm1026_read_value(client, ADM1026_REG_GPIO_MASK_0_7);
+		data->gpio_mask =3D gpio;
+
+		/* Read various values from CONFIG1 */
+		data->config1 =3D adm1026_read_value(client,=20
+			ADM1026_REG_CONFIG1);
+		if (data->config1 & CFG1_PWM_AFC) {
+			data->pwm1.enable =3D 2;
+			data->pwm1.auto_pwm_min =3D=20
+				PWM_MIN_FROM_REG(data->pwm1.pwm);
+		}
+		/* Read the GPIO config */
+		data->config2 =3D adm1026_read_value(client,=20
+			ADM1026_REG_CONFIG2);
+		data->config3 =3D adm1026_read_value(client,=20
+			ADM1026_REG_CONFIG3);
+		data->gpio_config[16] =3D (data->config3 >> 6) & 0x03;
+
+		value =3D 0;
+		for (i =3D 0;i <=3D 15;++i) {
+			if ((i & 0x03) =3D 0) {
+				value =3D adm1026_read_value(client,
+					    ADM1026_REG_GPIO_CFG_0_3 + i/4);
+			}
+			data->gpio_config[i] =3D value & 0x03;
+			value >>=3D 2;
+		}
+
+		data->last_config =3D jiffies;
+	};  /* last_config */
+
+	dev_dbg(&client->dev, "Setting VID from GPIO11-15.\n");
+	data->vid =3D (data->gpio >> 11) & 0x1f;
+	data->valid =3D 1;
+	up(&data->update_lock);
+	return data;
+}
