+/* Called when we have found a new GL520SM. */
+static void gl520_init_client(struct i2c_client *client)
+{
+	struct gl520_data *data =3D i2c_get_clientdata(client);
+	u8 oldconf, conf;
+
+	conf =3D oldconf =3D gl520_read_value(client, GL520_REG_CONF);
+
+	data->alarm_mask =3D 0xff;
+	data->vrm =3D i2c_which_vrm();
+
+	if (extra_sensor_type =3D 1)
+		conf &=3D ~0x10;
+	else if (extra_sensor_type =3D 2)
+		conf |=3D 0x10;
+	data->two_temps =3D !(conf & 0x10);
+
+	/* If IRQ# is disabled, we can safely force comparator mode */
+	if (!(conf & 0x20))
+		conf &=3D 0xf7;
+
+	/* Enable monitoring if needed */
+	conf |=3D 0x40;
+
+	if (conf !=3D oldconf)
+		gl520_write_value(client, GL520_REG_CONF, conf);
+
+	gl520_update_device(&(client->dev));
+
+	if (data->fan_min[0] =3D 0)
+		data->alarm_mask &=3D ~0x20;
+	if (data->fan_min[1] =3D 0)
+		data->alarm_mask &=3D ~0x40;
+
+	data->beep_mask &=3D data->alarm_mask;
+	gl520_write_value(client, GL520_REG_BEEP_MASK, data->beep_mask);
+}
+
+static int gl520_detach_client(struct i2c_client *client)
+{
+	int err;
+
+	if ((err =3D i2c_detach_client(client))) {
+		dev_err(&client->dev, "Client deregistration failed, "
+			"client not detached.\n");
+		return err;
+	}
+
+	kfree(i2c_get_clientdata(client));
+	return 0;
+}
