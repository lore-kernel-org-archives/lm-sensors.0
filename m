+
+	superio_enter();
+	chip_type =3D superio_inw(DEVID);
+	if (chip_type !=3D IT8712F_DEVID
+	 && chip_type !=3D IT8705F_DEVID)
+	 	goto exit;
+
+	superio_select();
+	if (!(superio_inb(IT87_ACT_REG) & 0x01)) {
+		pr_info("it87: Device not activated, skipping\n");
+		goto exit;
+	}
